DB_USER=cyberstars
DB_HOST=localhost
DB_NAME=cyberstars
DB_PASSWORD=change-me
DB_PORT=5432

DATABASE_URL=postgresql://cyberstars:change-me@localhost:5432/cyberstars

EXPRESS_PORT=5000
JWT_SECRET=change-me-to-a-random-string

NODE_ENV=development

# CORS origin for the server (env.ts). In dev, set to the Vite dev server origin.
CORS_DEV_ORIGIN=http://localhost:5173
# Production CORS origin (defaults to https://cyber-stars.org if not set).
# CORS_ORIGIN=https://cyber-stars.org
# Client-side API base URL in production (empty = same-origin, correct when Express serves the client).
VITE_PROD_API_URL=
