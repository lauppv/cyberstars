{
  "name": "cyberstars",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "framework/*"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "db:prepare": "npm run db:prepare -w @cyberstars/api",
    "gen:content": "npm run gen:content -w @cyberstars/ui",
    "validate:tests": "npm run validate:tests -w @cyberstars/api",
    "check:tests": "npm run check:tests -w @cyberstars/api --",
    "check:tutor": "npm run check:tutor -w @cyberstars/api --",
    "make:quiz": "npm run make:quiz -w @cyberstars/api --",
    "check:quiz": "npm run check:quiz -w @cyberstars/api",
    "dev": "npm run db:prepare && concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "predev:client": "npm run gen:content",
    "dev:client": "npm run dev -w @cyberstars/ui",
    "dev:server": "npm run dev -w @cyberstars/api",
    "prebuild": "npm run gen:content",
    "build": "npm run build -w @cyberstars/ui",
    "start": "npm run start -w @cyberstars/api",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run test:integration -w @cyberstars/api",
    "typecheck": "tsc --noEmit && npm run typecheck -w @cyberstars/api && tsc -p e2e/tsconfig.json --noEmit",
    "dead-code": "knip && npm run dead-code:framework",
    "dead-code:framework": "if ls framework/*/package.json > /dev/null 2>&1; then knip --strict --workspace './framework/*'; fi",
    "preview": "npm run preview -w @cyberstars/ui",
    "db:generate": "npm run db:generate -w @cyberstars/api",
    "db:migrate": "npm run db:migrate -w @cyberstars/api",
    "db:deploy": "npm run db:deploy -w @cyberstars/api",
    "db:seed": "npm run db:seed -w @cyberstars/api",
    "db:studio": "npm run db:studio -w @cyberstars/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "dotenv -e .env.test -- playwright test --config e2e/playwright.config.ts",
    "test:e2e:browser": "dotenv -e .env.test -- playwright test --config e2e/playwright.config.ts --project=browser",
    "test:e2e:docker": "dotenv -e .env.test -- playwright test --config e2e/playwright.config.ts --project=docker",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "deepmerge-ts": "^8.0.1"
  }
}
