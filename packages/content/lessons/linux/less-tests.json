{
  "checks": [
    {
      "kind": "files_equal",
      "a": "manual.txt",
      "b": "manuals/manual-archive.txt"
    }
  ],
  "requires": [
    {
      "kind": "command",
      "pattern": "^(?=.*\\bcat\\b)(?=.*manual\\.txt)"
    },
    {
      "kind": "command",
      "pattern": "^(?=.*\\bwc\\b)(?=.* -\\S*l)(?=.*manual\\.txt)"
    }
  ]
}
