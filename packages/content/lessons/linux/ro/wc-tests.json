    { "kind": "files_equal", "a": "inventar.txt", "b": "manifest/inventar-verificat.txt" }
  ],
  "requires": [
    { "kind": "command", "pattern": "wc\\b.*-l\\b.*inventar\\.txt" },
    { "kind": "command", "name": "cp" },
    { "kind": "command", "pattern": "wc\\b.*-l\\b.*inventar-verificat\\.txt" }
  ]
}
