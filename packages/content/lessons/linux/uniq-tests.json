{
  "checks": [
    { "kind": "dir_exists", "path": "security" },
    { "kind": "file_contains", "path": "security/access-tally.txt", "text": "Voss" }
  ],
  "requires": [
    { "kind": "command", "pattern": "sort\\b.*door_access\\.log" },
    { "kind": "command", "pattern": "uniq\\b.*-c" },
