{
  "checks": [
    {
      "kind": "files_equal",
      "a": "inventory.txt",
      "b": "manifest/inventory-checked.txt"
    }
  ],
  "requires": [
    {
      "kind": "command",
      "pattern": "^(?=.*\\bwc\\b)(?=.* -\\S*l)(?=.*inventory\\.txt)"
    },
    {
      "kind": "command",
      "pattern": "^(?=.*\\bwc\\b)(?=.* -\\S*l)(?=.*inventory-checked\\.txt)"
    }
  ]
}
