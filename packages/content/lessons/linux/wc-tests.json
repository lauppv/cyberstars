{
  "checks": [
    { "kind": "dir_exists", "path": "manifest" },
    { "kind": "files_equal", "a": "inventory.txt", "b": "manifest/inventory-checked.txt" }
  ],
  "requires": [
    { "kind": "command", "pattern": "wc\\b.*-l\\b.*inventory\\.txt" },
    { "kind": "command", "name": "cp" },
    { "kind": "command", "pattern": "wc\\b.*-l\\b.*inventory-checked\\.txt" }
  ]
}
