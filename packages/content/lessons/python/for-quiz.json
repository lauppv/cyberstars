    {
      "id": "q28",
      "text": "What does `total = total + i` do on each iteration?",
      "options": [
        "It puts i in total, in place of what was there",
        "It adds total and i, then throws the result away",
        "It doubles total",
        "It adds i to what total held before"
      ],
      "answer": 3
    },
    {
      "id": "q29",
