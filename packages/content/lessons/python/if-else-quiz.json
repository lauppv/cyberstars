      "answer": 0
    },
    {
      "id": "q6",
      "text": "Which values make `x > 15` true?",
      "options": ["15, 16 and 20", "16, 20 and 145", "15 and below", "Only 15"],
      "answer": 1
    },
    {
      "id": "q7",
      "text": "What does >= mean?",
      "options": [
        "Greater than",
        "Less than or equal to",
        "Greater than or equal to",
        "Not equal to"
      ],
      "answer": 2
    },
    {
      "id": "q8",
      "text": "What is the difference between = and ==?",
      "options": [
        "= stores a value in a variable, == checks whether two values are equal",
        "They do the same thing",
        "== stores a value twice",
        "= checks whether two values are equal, == stores a value"
      ],
      "answer": 0
    },
    {
      "id": "q9",
      "text": "What happens when this runs?",
      "code": "x = 4\nif x = 4:\n    print(\"Boo\")",
      "options": [
        "It prints Boo",
        "It prints nothing",
        "It stops with an error: the if needs ==",
        "It prints 4"
      ],
      "answer": 2
    },
    {
      "id": "q10",
      "text": "Does every if need an else?",
      "options": [
        "Yes, always",
        "No, only when something must also happen when the condition is false",
        "Only at the end of a program",
        "Only when the if compares numbers"
      ],
      "answer": 1
    },
    {
      "id": "q11",
      "text": "When an if has an else, how many of the two blocks run?",
      "options": [
        "Exactly one of them",
        "Both, one after the other",
        "Neither",
        "Both, at the same time"
      ],
      "answer": 0
    },
    {
      "id": "q12",
      "text": "What are True and False?",
      "options": [
        "Two pieces of text",
        "The numbers 1 and 2",
        "Two variables we have to create first",
        "The two values a condition can have: yes or no"
      ],
      "answer": 3
    },
