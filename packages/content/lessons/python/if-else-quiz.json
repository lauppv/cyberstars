{
  "questions": [
    {
      "id": "q1",
      "text": "What does else mean in an if / else?",
      "options": [
        "Otherwise: its lines run when the if's condition is false",
        "Also: its lines always run after the if",
        "Stop: the program ends there",
        "Again: the if runs one more time"
      ],
      "answer": 0
    },
    {
      "id": "q2",
      "text": "What has to come at the end of an if line?",
      "options": [";", ":", ".", ","],
      "answer": 1
    },
    {
      "id": "q3",
      "text": "Why are the lines under if indented?",
      "options": [
        "Only to look nicer",
        "So they run faster",
        "So Python knows they belong to the if",
        "Python ignores the spaces anyway"
      ],
      "answer": 2
    },
    {
      "id": "q4",
      "text": "What does < mean in `if temperature < 15:`?",
