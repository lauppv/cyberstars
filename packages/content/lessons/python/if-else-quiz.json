      "id": "q23",
      "text": "An exam is passed with at least 50 points. Which program says so?",
      "options": [
        "if score > 50:\n    print(\"Pass\")\nelse:\n    print(\"Fail\")",
        "if score >= 50:\n    print(\"Pass\")\nelse:\n    print(\"Fail\")",
