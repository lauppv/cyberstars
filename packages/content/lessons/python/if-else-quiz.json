    {
      "id": "q1-v2",
      "text": "What does else mean in an if / else?",
      "options": [
        "Otherwise: it runs only when the if's condition is false",
        "Also: it always runs too, right after the if's block",
        "Then: it runs only when the if's condition is true",
        "Error: it runs only when the if's block has an error"
      ],
      "answer": 0
    },
    {
      "id": "q2",
      "text": "What has to come at the end of an if line?",
      "options": [";", ":", ".", ","],
      "answer": 1
    },
    {
      "id": "q3-v2",
      "text": "Why are the lines under if indented?",
      "options": [
        "Only to make the code easier for people to read",
