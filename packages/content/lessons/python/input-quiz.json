    {
      "id": "q1",
      "text": "What does input() do?",
      "options": [
        "It stops the program and waits for the user to type something and press Enter",
        "It prints a message on the screen and goes on",
        "It reads the next line of the program",
        "It makes up a value for the variable"
      ],
      "answer": 0
    },
    {
      "id": "q2",
      "text": "What does input() give back when the user types a number?",
      "options": [
        "An integer",
        "A string, text like \"18\"",
        "A number with decimals",
        "True or False"
      ],
      "answer": 1
    },
    {
      "id": "q3",
      "text": "The user types 18 at `age = input()`. What does age hold?",
      "options": [
