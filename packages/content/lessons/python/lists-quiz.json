    {
      "id": "q1",
      "text": "What is a list?",
      "options": [
        "Many values kept in one variable",
        "A variable that holds exactly one value",
        "A kind of loop",
        "A kind of comment"
      ],
      "answer": 0
    },
    {
      "id": "q2",
      "text": "Which brackets make a list?",
      "options": ["( )", "[ ]", "{ }", "< >"],
      "answer": 1
    },
    {
      "id": "q3",
      "text": "What goes between the elements of a list?",
      "options": ["A dot", "A semicolon", "A comma", "The word and"],
      "answer": 2
    },
    {
      "id": "q4",
      "text": "What index does the first element of a list have?",
      "options": ["1", "It has no index", "-1", "0"],
      "answer": 3
    },
    {
      "id": "q5",
      "text": "`names = [\"Tommy\", \"Lance\", \"Cortez\"]`. Which one is \"Lance\"?",
