{
  "questions": [
    {
      "id": "q1",
      "text": "How does Python store a matrix?",
      "options": [
        "As one long list, read three at a time",
        "As a dictionary from row numbers to values",
        "As a list of lists, each inner list being a row",
        "As a string with a line per row"
      ],
      "answer": 2
    },
    {
      "id": "q2",
      "text": "What does this print?",
      "code": "matrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7, 8, 9]\n]\nprint(matrix[1][2])",
      "options": ["6", "8", "2", "5"],
      "answer": 0
    },
    {
      "id": "q3",
      "text": "In `matrix[i][j]`, what does `i` choose?",
      "options": ["The column", "The value", "How many rows there are", "The row"],
      "answer": 3
    },
    {
      "id": "q4",
      "text": "What does this print?",
      "code": "matrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7, 8, 9]\n]\nprint(matrix[2][0])",
      "options": ["3", "7", "1", "9"],
      "answer": 1
    },
    {
      "id": "q5",
      "text": "What does this print?",
      "code": "matrix = [\n    [4, 0, 7],\n    [1, 5, 2]\n]\nprint(len(matrix))\nprint(len(matrix[0]))",
      "options": ["3\n2", "6\n3", "2\n3", "2\n2"],
      "answer": 2
    },
    {
      "id": "q6",
      "text": "What does this print?",
      "code": "matrix = [\n    [1, 2],\n    [3, 4]\n]\nfor row in matrix:\n    for element in row:\n        print(element, end=\" \")\n    print()",
