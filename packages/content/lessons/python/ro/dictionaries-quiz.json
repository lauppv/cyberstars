    {
      "id": "q1",
      "text": "Ce este un dicționar?",
      "options": [
        "Perechi cheie: valoare, în care căutăm o valoare după cheia ei",
        "O listă ale cărei elemente stau sortate",
        "O variabilă care ține exact un nume",
        "O listă de valori pe care le citim după poziție"
      ],
      "answer": 0
    },
    {
      "id": "q2",
      "text": "Ce paranteze fac un dicționar?",
      "options": ["[ ]", "{ }", "( )", "< >"],
      "answer": 1
    },
    {
      "id": "q3",
      "text": "În `{\"Cortez\": \"555-1234\"}`, ce este `\"Cortez\"`?",
