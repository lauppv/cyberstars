{
  "questions": [
    {
      "id": "q1",
      "text": "Ce dă len() pentru un string?",
      "options": [
        "Câte cuvinte are",
        "Câte caractere are, cu tot cu spații și semne",
        "Câte litere are, fără spații",
        "Poziția ultimului lui caracter"
      ],
      "answer": 1
    },
    {
      "id": "q2",
      "text": "Ce afișează?",
      "code": "nume = \"Tommy Vercetti\"\nprint(len(nume))",
      "options": ["14", "13", "2", "12"],
      "answer": 0
    },
    {
      "id": "q3",
      "text": "De unde începe numărarea pozițiilor dintr-un string?",
      "options": ["De la 1", "De la ultimul caracter", "De la primul spațiu", "De la 0"],
      "answer": 3
    },
    {
      "id": "q4",
      "text": "`nume` ține \"Tommy\". Ce este `nume[1]`?",
