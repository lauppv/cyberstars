      "id": "q24",
      "text": "What does this print?",
      "code": "word = \"planet\"\nprint(word[0:3] + word[3:])",
      "options": ["pla", "net", "planet", "plannet"],
      "answer": 2
    },
    {
      "id": "q25",
      "text": "What does this print?",
