    {
      "id": "q30",
      "text": "`name` holds \"tommy\". Which line prints Tommy, with only the first letter in capitals?",
      "options": [
        "print(name[0].upper() + name[1:])",
        "print(name.upper())",
        "print(name[0] + name[1:].upper())",
        "print(name[0].upper())"
      ],
      "answer": 0
    }
