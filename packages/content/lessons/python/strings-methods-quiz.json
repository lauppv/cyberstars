    {
      "id": "q29",
      "text": "Which line stops with an error?",
      "options": [
        "print(\"Level \" + \"5\")",
        "print(\"Level \" + 5)",
        "print(f\"Level {5}\")",
        "print(\"Level 5\")"
      ],
      "answer": 1
