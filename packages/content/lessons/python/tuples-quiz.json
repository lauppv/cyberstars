{
  "questions": [
    {
      "id": "q1",
      "text": "What is the big difference between a tuple and a list?",
      "options": [
        "A tuple can hold only numbers",
        "A tuple can't be changed once it is made",
        "A tuple has no indexes",
        "A tuple can hold at most two values"
      ],
      "answer": 1
    },
    {
      "id": "q2",
      "text": "Which brackets make a tuple?",
      "options": ["[ ]", "{ }", "( )", "< >"],
      "answer": 2
    },
    {
      "id": "q3",
      "text": "What happens when this runs?",
      "code": "coordinates = (10, 20)\ncoordinates[0] = 99\nprint(coordinates)",
      "options": [
        "coordinates becomes (99, 20)",
        "coordinates becomes (99, 10, 20)",
        "It stops with a TypeError: a tuple can't be changed",
        "Nothing: Python skips that line"
      ],
      "answer": 2
    },
    {
      "id": "q4",
      "text": "What does this print?",
      "code": "player = (\"Tommy Vercetti\", 100, \"Vice City\")\nprint(player[1])",
      "options": ["100", "Tommy Vercetti", "Vice City", "('Tommy Vercetti', 100)"],
      "answer": 0
    },
    {
      "id": "q5",
      "text": "`player = (\"Tommy Vercetti\", 100, \"Vice City\")`. What does `len(player)` give?",
      "options": ["14", "2", "1", "3"],
      "answer": 3
    },
    {
      "id": "q6",
      "text": "What does this print?",
