{
  "cases": [
    {
      "name": "The name box is described by its message",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "attr": "#passenger",
          "name": "aria-describedby",
          "equals": "passenger-error",
          "label": "the name box"
        },
        {
          "exists": "form #passenger-error",
          "label": "the message next to the name box (#passenger-error)"
        },
        {
          "count": "#passenger[aria-invalid=\"true\"]",
          "equals": 0,
          "label": "name boxes marked as wrong"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "A name of only spaces marks the box as wrong",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "fill": "#passenger",
          "text": "   ",
          "label": "the name box"
        },
        {
          "fill": "#email",
          "text": "ida@example.com",
          "label": "the email box"
        },
        {
          "select": "#flight",
          "option": "SL-102",
          "label": "the flight list"
        },
        {
          "fill": "#travel-date",
          "text": "2031-05-14",
          "label": "the date box"
        },
        {
          "fill": "#badge-number",
          "text": "OS4821",
          "label": "the badge number box"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "text": "#passenger-error",
          "equals": "Please write your name",
          "label": "the message next to the name box (#passenger-error)"
        },
        {
          "attr": "#passenger",
          "name": "aria-invalid",
          "equals": "true",
          "label": "the name box, with only spaces in it"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "Once the name is right, the box isn't marked as wrong any more",
