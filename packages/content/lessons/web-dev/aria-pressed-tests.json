{
  "cases": [
    {
      "name": "System is pressed, Light and Dark aren't",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "attr": "#theme-system",
          "name": "aria-pressed",
          "equals": "true",
          "label": "the System button (#theme-system)"
        },
        {
          "attr": "#theme-light",
          "name": "aria-pressed",
          "equals": "false",
          "label": "the Light button (#theme-light)"
        },
        {
          "attr": "#theme-dark",
          "name": "aria-pressed",
          "equals": "false",
          "label": "the Dark button (#theme-dark)"
        }
      ]
    },
    {
      "name": "The pressed button looks pressed",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "differs": "#theme-system",
          "from": "#theme-light, #theme-dark",
          "props": ["background-color", "color", "border-top-color", "font-weight"],
          "fromLabel": "the buttons that aren't pressed",
          "label": "the pressed button"
        },
        {
          "contrast": "#theme-buttons button",
          "atLeast": 4.5,
          "every": true,
          "label": "every theme button's text"
        }
      ]
    },
    {
      "name": "The look follows aria-pressed",
      "page": "settings.html",
      "files": {
        "settings.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content=\"Pick how the station's website looks for you: light or dark, with more or less movement.\" />\n    <title>Settings</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script src=\"menu.js\" defer></script>\n  </head>\n  <body>\n    <header>\n      <p class=\"site-name\">Orbital Station 7</p>\n      <button type=\"button\" id=\"menu-button\" aria-expanded=\"false\">Menu</button>\n      <nav aria-label=\"Main menu\">\n        <a href=\"index.html\">Home</a>\n        <a href=\"crew.html\">Crew</a>\n        <a href=\"schedule.html\">Schedule</a>\n        <a href=\"boarding.html\">Boarding</a>\n        <a href=\"wiki.html\">Wiki</a>\n        <a href=\"dashboard.html\">Dashboard</a>\n        <a href=\"settings.html\">Settings</a>\n      </nav>\n    </header>\n    <main>\n    <h1>Settings</h1>\n    <p>Make the station's website yours. Your choice is for this browser only.</p>\n\n    <section>\n      <h2>Theme</h2>\n      <div id=\"theme-buttons\">\n        <button type=\"button\" id=\"theme-light\" aria-pressed=\"false\">Light</button>\n        <button type=\"button\" id=\"theme-dark\" aria-pressed=\"true\">Dark</button>\n        <button type=\"button\" id=\"theme-system\" aria-pressed=\"false\">System</button>\n      </div>\n    </section>\n    </main>\n\n    <footer>\n      <p>Orbital Station 7 · Docking Ring B · Low Earth Orbit</p>\n      <p>Written by the crew, for everyone on board and back on Earth.</p>\n    </footer>\n  </body>\n</html>\n"
      },
      "steps": [
        {
          "differs": "#theme-dark",
          "from": "#theme-light, #theme-system",
          "props": ["background-color", "color", "border-top-color", "font-weight"],
          "fromLabel": "the buttons that aren't pressed",
          "label": "the pressed button"
        }
      ]
    }
  ]
}
