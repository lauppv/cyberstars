{
  "cases": [
    {
      "name": "Links that open a new tab are underlined",
      "visible": true,
      "steps": [
        {
          "style": "a[target=\"_blank\"]",
          "prop": "text-decoration-line",
          "every": true,
          "equals": "underline",
          "label": "every link that opens a new tab"
        }
      ]
    },
    {
      "name": "The other links are not",
      "visible": true,
      "steps": [
        {
          "style": "a:not([target=\"_blank\"])",
          "prop": "text-decoration-line",
          "every": true,
          "equals": "none",
          "label": "every other link"
        }
      ]
    }
  ]
}
