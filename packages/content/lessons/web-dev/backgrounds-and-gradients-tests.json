{
  "cases": [
    {
      "name": "The banner shows the station",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "exists": "h1 + p + div.banner",
          "label": "the banner, in the class banner, right after the introduction"
        },
        {
          "style": ".banner",
          "prop": "background-image",
          "endsWith": "img/station.svg\")",
          "label": "the banner"
        },
        {
          "style": ".banner",
          "prop": "background-size",
          "equals": "cover",
          "label": "the banner"
        },
        {
          "style": ".banner",
          "prop": "background-position",
          "equals": "50% 50%",
          "label": "the banner"
        }
      ]
    },
    {
      "name": "It has its size and corners",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "size": ".banner",
          "minHeight": 120,
          "maxHeight": 240,
          "label": "the banner"
        },
        {
          "style": ".banner",
          "prop": "border-top-left-radius",
          "atLeast": 4,
          "label": "the banner"
        },
        {
          "style": ".banner",
          "prop": "border-bottom-right-radius",
          "atLeast": 4,
          "label": "the banner"
        }
      ]
    },
    {
      "name": "The header cells have a gradient",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "style": "#flights th",
          "prop": "background-image",
          "not": "none",
          "every": true,
          "label": "a header cell of the flights table"
        }
      ]
    }
  ]
}
