        },
        {
          "count": "#badge-number[aria-invalid=\"true\"]",
          "equals": 0,
          "label": "badge number boxes marked as wrong"
        },
        {
          "text": "#pass-badge",
          "equals": "OS4821",
          "label": "the badge number on the pass (#pass-badge)"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "The rest of the form and the pass still work",
