{
  "cases": [
    {
      "name": "A wrong badge number gets its message once the passenger leaves the box",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "text": "#badge-error",
          "equals": "",
          "label": "the message next to the badge number box at the start (#badge-error)"
        },
        {
          "count": "#badge-number[aria-invalid=\"true\"]",
          "equals": 0,
          "label": "badge number boxes marked as wrong"
        },
        {
          "order": ["#badge-number", "#badge-error", "label[for=\"phone\"]"],
          "label": "the badge number box, its message, then the label of the phone box"
        },
        {
          "fill": "#badge-number",
          "text": "OS482",
          "label": "the badge number box"
        },
        {
          "press": "Tab",
          "on": "#badge-number",
          "label": "the badge number box"
        },
        {
          "text": "#badge-error",
          "equals": "Two capital letters and four digits, like OS4821",
          "label": "the message next to the badge number box (#badge-error)"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "A screen reader hears the message, and that the box is wrong",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "attr": "#badge-number",
          "name": "aria-describedby",
          "equals": "badge-error",
          "label": "the badge number box"
        },
        {
          "exists": "form #badge-error",
          "label": "the message next to the badge number box (#badge-error)"
        },
        {
          "fill": "#badge-number",
          "text": "os4821",
          "label": "the badge number box"
        },
        {
          "press": "Tab",
          "on": "#badge-number",
          "label": "the badge number box"
        },
        {
          "attr": "#badge-number",
          "name": "aria-invalid",
          "equals": "true",
          "label": "the badge number box, left with a wrong number"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "Once the number is right, the message goes away",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "fill": "#badge-number",
          "text": "OS482",
          "label": "the badge number box"
        },
        {
          "press": "Tab",
          "on": "#badge-number",
          "label": "the badge number box"
        },
        {
          "text": "#badge-error",
