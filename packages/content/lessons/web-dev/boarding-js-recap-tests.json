        },
        {
          "text": "#pass-help",
          "equals": "yes",
          "label": "the line Help at the gate on the pass (#pass-help)"
        },
        {
          "text": "#pass-destination",
          "equals": "Mars Relay",
          "label": "the destination on the pass (#pass-destination)"
        },
        {
          "noErrors": true
        }
      ]
    },
