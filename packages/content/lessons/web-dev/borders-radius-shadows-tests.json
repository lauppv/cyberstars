{
  "cases": [
    {
      "name": "The cards have rounded corners and a shadow",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "style": ".card",
          "prop": "border-top-left-radius",
          "atLeast": 4,
          "every": true,
          "label": "a card"
        },
        {
          "style": ".card",
          "prop": "border-top-right-radius",
          "atLeast": 4,
          "every": true,
          "label": "a card"
        },
        {
          "style": ".card",
          "prop": "border-bottom-right-radius",
          "atLeast": 4,
          "every": true,
          "label": "a card"
        },
        {
          "style": ".card",
          "prop": "border-bottom-left-radius",
          "atLeast": 4,
          "every": true,
          "label": "a card"
        },
        {
          "style": ".card",
          "prop": "box-shadow",
          "not": "none",
          "every": true,
          "label": "a card"
        }
      ]
    },
    {
      "name": "The pictures have rounded corners",
      "visible": true,
      "steps": [
        {
          "style": "img",
          "prop": "border-top-left-radius",
          "atLeast": 4,
          "every": true,
          "label": "a picture of the home page"
        },
        {
          "style": "img",
          "prop": "border-bottom-right-radius",
          "atLeast": 4,
          "every": true,
          "label": "a picture of the home page"
        }
      ]
    },
    {
      "name": "The navigation's links have a line along their bottom only",
      "visible": true,
      "steps": [
        {
          "style": "nav a",
          "prop": "border-bottom-width",
          "atLeast": 1,
          "every": true,
          "label": "a link of the navigation"
        },
        {
          "style": "nav a",
          "prop": "border-bottom-style",
          "not": "none",
          "every": true,
          "label": "a link of the navigation"
        },
        {
          "style": "nav a",
          "prop": "border-top-width",
          "equals": "0px",
          "label": "the top of a link of the navigation"
        },
        {
          "style": "nav a",
          "prop": "border-left-width",
          "equals": "0px",
          "label": "the left side of a link of the navigation"
        }
      ]
    }
  ]
}
