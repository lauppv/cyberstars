{
  "cases": [
    {
      "name": "The page is dark, its text light",
      "visible": true,
      "steps": [
        {
          "contrast": "body",
          "atLeast": 4.5,
          "on": "dark",
          "label": "the page's text"
        },
        {
          "contrast": "p:not(.warning)",
          "atLeast": 4.5,
          "on": "dark",
          "every": true,
          "label": "a paragraph"
        }
      ]
    },
    {
      "name": "The headings read on the dark",
      "visible": true,
      "steps": [
        {
          "contrast": "h1, h2, h3",
          "atLeast": 4.5,
          "on": "dark",
          "every": true,
          "label": "a heading"
        }
      ]
    },
    {
      "name": "The links read on the dark",
      "visible": true,
      "steps": [
        {
          "contrast": "a",
          "atLeast": 4.5,
          "on": "dark",
          "every": true,
          "label": "a link"
        }
      ]
    },
    {
      "name": "The warnings stand out, and read",
      "visible": true,
      "steps": [
        {
          "differs": ".warning",
          "from": "p:not(.warning)",
          "props": ["color", "background-color"],
          "fromLabel": "the other paragraphs",
          "label": "the warnings"
        },
        {
          "contrast": ".warning",
          "atLeast": 4.5,
          "every": true,
          "label": "a warning"
        }
      ]
    },
    {
      "name": "The small numbers and stressed words read on the dark",
      "visible": true,
      "steps": [
        {
          "contrast": "sub, sup",
          "atLeast": 4.5,
          "on": "dark",
          "every": true,
          "label": "a number below or above the line"
        },
        {
          "contrast": "em, strong",
          "atLeast": 4.5,
          "every": true,
          "label": "a stressed or important word"
        }
      ]
    },
    {
      "name": "Today on Board stands out from the other sections",
      "visible": true,
      "steps": [
        {
          "differs": "#today",
          "from": "h2:not(#today)",
          "props": ["color", "background-color"],
          "fromLabel": "the other section headings",
          "label": "the heading Today on Board"
        }
      ]
    }
  ]
}
