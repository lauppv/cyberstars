{
  "cases": [
    {
      "name": "Every job has a background of its own",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "differs": ".role",
          "from": ".card",
          "props": ["background-color"],
          "fromLabel": "its card",
          "label": "every job"
        }
      ]
    },
    {
      "name": "Every job has room on its sides and rounded corners",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "style": ".role",
          "prop": "padding-left",
          "every": true,
          "atLeast": 4,
          "label": "every job"
        },
        {
          "style": ".role",
          "prop": "padding-right",
          "every": true,
          "atLeast": 4,
          "label": "every job"
        },
        {
          "style": ".role",
          "prop": "border-top-left-radius",
          "every": true,
          "atLeast": 4,
          "label": "every job"
        }
      ]
    },
    {
      "name": "Every job stays on its line and reads easily",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "style": ".role",
          "prop": "display",
          "every": true,
          "not": "block",
          "label": "every job"
        },
        {
          "contrast": ".role",
          "atLeast": 4.5,
          "every": true,
          "label": "every job"
        }
      ]
    }
