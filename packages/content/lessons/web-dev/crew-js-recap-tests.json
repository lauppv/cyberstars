      "files": {
        "crew.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Crew Directory</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script src=\"crew.js\" defer></script>\n  </head>\n  <body>\n    <h1>Crew Directory</h1>\n    <ul id=\"crew\">\n      <li>Ada</li>\n      <li>Bram</li>\n      <li>Chen</li>\n      <li>Dara</li>\n      <li>Eli</li>\n    </ul>\n    <p id=\"roster\"></p>\n    <button type=\"button\" id=\"add-rookie\">Add a rookie</button>\n    <button type=\"button\" id=\"remove-last\">Remove the last</button>\n    <p id=\"latest\"></p>\n    <div id=\"cards\">\n      <div class=\"card\">\n        <h3>Ada</h3>\n        <p>Job: <span class=\"role\">Engineer</span></p>\n        <p>Hours this week: <span class=\"worked\">10</span></p>\n      </div>\n      <div class=\"card\">\n        <h3>Bram</h3>\n        <p>Job: <span class=\"role\">Pilot</span></p>\n        <p>Hours this week: <span class=\"worked\">20</span></p>\n      </div>\n      <div class=\"card\">\n        <h3>Chen</h3>\n        <p>Job: <span class=\"role\">Medic</span></p>\n        <p>Hours this week: <span class=\"worked\">31</span></p>\n      </div>\n    </div>\n    <p id=\"hours-total\"></p>\n    <p id=\"watch-time\"></p>\n    <button type=\"button\" id=\"roll-call-button\">Roll call</button>\n    <ol id=\"roll-call\"></ol>\n    <p id=\"roll-summary\"></p>\n    <button type=\"button\" id=\"call-dinner\">Call to dinner</button>\n    <button type=\"button\" id=\"call-bridge\">Call to the bridge</button>\n    <p id=\"intercom\"></p>\n    <p>Oxygen tanks: <span id=\"tanks\">7</span>, each lasting <span id=\"tank-hours\">20</span> hours.</p>\n    <p id=\"oxygen\"></p>\n    <p>Launch countdown from <span id=\"countdown-from\">4</span></p>\n    <p id=\"countdown\"></p>\n  </body>\n</html>\n"
      },
      "steps": [
        {
          "click": "button#roll-call-button",
          "label": "the button Roll call"
