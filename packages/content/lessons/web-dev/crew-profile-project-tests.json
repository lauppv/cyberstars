{
  "cases": [
    {
      "name": "The frame: doctype, English, any letter, the tab",
      "visible": true,
      "steps": [
        {
          "doctype": true
        },
        {
          "exists": "html[lang|=\"en\" i]",
          "label": "the <html> tag with lang set to English"
        },
        {
          "attr": "head meta[charset]",
          "name": "charset",
          "equals": "UTF-8",
          "ignoreCase": true,
          "label": "a <meta> tag in the <head>"
        },
        {
          "text": "head > title",
          "equals": "Crew Profile",
          "label": "a <title> in the <head>"
        }
      ]
    },
    {
      "name": "The name is the one biggest heading, the job under it",
      "visible": true,
      "steps": [
        {
          "count": "h1",
          "equals": 1,
          "label": "biggest headings"
        },
        {
          "text": "h1",
          "nonEmpty": true,
          "label": "the name"
        },
        {
          "text": "h1 + p.role",
          "nonEmpty": true,
          "label": "the job, right under the name (<p class=\"role\">)"
        }
      ]
    },
    {
      "name": "Two parts, something important and an email link",
      "visible": true,
      "steps": [
        {
          "count": "h1 ~ h2",
          "atLeast": 2,
          "label": "part headings (<h2>)"
        },
        {
          "outline": true
        },
        {
          "text": "h2 ~ p strong",
          "nonEmpty": true,
          "label": "something important (<strong>) in a part"
        },
        {
          "exists": "a[href^=\"mailto:\"]",
          "label": "a link that starts an email"
        }
      ]
    },
    {
      "name": "style.css gives the page its look",
      "visible": true,
      "steps": [
        {
          "exists": "head link[rel=\"stylesheet\"][href=\"style.css\"]",
          "label": "a <link> to style.css in the <head>"
        },
        {
          "style": "h1",
          "prop": "text-align",
          "equals": "center",
          "label": "the name"
        },
        {
          "style": "p.role",
          "prop": "font-style",
          "equals": "italic",
          "label": "the job"
        }
      ]
    },
    {
      "name": "Every rule is in style.css",
      "visible": false,
      "files": {
        "style.css": "h1 { color: rgb(1, 2, 3); }"
      },
      "steps": [
        {
          "style": "h1",
          "prop": "color",
          "equals": "rgb(1, 2, 3)",
          "label": "the name"
        }
      ]
    },
    {
      "name": "The text reads well",
      "visible": true,
      "steps": [
        {
          "contrast": "h1, h2",
          "atLeast": 3,
          "every": true,
          "label": "every heading"
        },
        {
          "contrast": "p",
          "atLeast": 4.5,
          "every": true,
          "label": "every paragraph"
        }
      ]
    },
    {
      "name": "The text grows with the visitor's font size",
      "visible": false,
      "files": {
        "zoom.css": "html { font-size: 32px; }\n",
        "zoomed.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <link rel=\"stylesheet\" href=\"zoom.css\" />\n  </head>\n  <body>\n    <h1>Ada Okafor</h1>\n    <p class=\"role\">Pilot</p>\n  </body>\n</html>\n"
      },
      "page": "zoomed.html",
      "steps": [
        {
          "size": "h1",
          "minHeight": 40,
          "label": "the name, for a visitor whose font size is 32px"
        },
        {
          "size": "p.role",
          "minHeight": 30,
          "label": "the job, for a visitor whose font size is 32px"
        }
      ]
    },
    {
      "name": "It fits a phone",
      "visible": true,
      "width": 375,
      "steps": [
        {
          "fits": true
        }
      ]
    }
  ]
}
