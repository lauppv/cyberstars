{
  "cases": [
    {
      "name": "The numbers are six cards, each with a heading and a number",
      "visible": true,
      "steps": [
        {
          "open": "dashboard.html"
        },
        {
          "count": ".stats > .stat",
          "atLeast": 6,
          "label": "cards (.stat) in .stats"
        },
        {
          "text": ".stats > .stat:nth-child(6) h2",
          "nonEmpty": true,
          "label": "the sixth card's heading"
        },
        {
          "text": ".stats > .stat .stat-value",
          "nonEmpty": true,
          "label": "a card's number (.stat-value)"
        },
        {
          "style": ".stats > .stat",
          "prop": "background-color",
          "not": "rgba(0, 0, 0, 0)",
          "every": true,
          "label": "every card's background"
        },
        {
          "order": [".stats", "#pad-camera"],
          "label": "the cards, then the pad camera"
        }
      ]
    },
    {
      "name": "On a computer, three columns",
      "visible": true,
      "steps": [
        {
          "open": "dashboard.html"
        },
        {
          "layout": ".stats > .stat:nth-child(1), .stats > .stat:nth-child(2), .stats > .stat:nth-child(3)",
