      "files": {
        "crew.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Crew Directory</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <nav>\n      <a href=\"index.html\">Home</a>\n      <a href=\"crew.html\">Crew</a>\n      <a href=\"crew.html#duty\">Duty</a>\n    </nav>\n    <h1>Crew Directory</h1>\n    <p>Everyone who lives and works on the station, and where to find them.</p>\n\n    <h2>Crew</h2>\n    <ul id=\"crew\">\n      <li>Mara Vega</li>\n      <li>Tomas Okafor</li>\n      <li>Ines Lindqvist</li>\n      <li>Kenji Arano</li>\n    </ul>\n\n    <h2>Morning Routine</h2>\n    <ol>\n      <li>Check the oxygen readings</li>\n      <li>Water the greenhouse</li>\n      <li>Report to the commander</li>\n    </ol>\n\n    <h2>Decks</h2>\n    <ul class=\"decks\">\n      <li>\n        Upper Deck\n        <ul>\n          <li>Bridge</li>\n          <li>Observatory</li>\n        </ul>\n      </li>\n      <li>\n        Living Deck\n        <ul>\n          <li>Galley</li>\n          <li>Sleeping pods</li>\n          <li>Gym</li>\n        </ul>\n      </li>\n      <li>\n        Lower Deck\n        <ul>\n          <li>Cargo bay</li>\n          <li>Greenhouse</li>\n        </ul>\n      </li>\n    </ul>\n\n    <div id=\"cards\">\n      <div class=\"card\">\n        <h3>Mara Vega</h3>\n        <p>Job: <span class=\"role\">Commander</span></p>\n        <p>Extra notes: has served on four stations, speaks three languages and keeps the greenhouse alive through every winter.</p>\n      </div>\n      <div class=\"card\">\n        <h3>Tomas Okafor</h3>\n        <p>Job: <span class=\"role\">Engineer</span></p>\n      </div>\n      <div class=\"card\">\n        <h3>Ines Lindqvist</h3>\n        <p>Job: <span class=\"role\">Pilot</span></p>\n      </div>\n      <div class=\"card\">\n        <h3>Kenji Arano</h3>\n        <p>Job: <span class=\"role\">Botanist</span></p>\n      </div>\n    </div>\n\n    <h2 id=\"duty\">Duty Board</h2>\n    <ol>\n      <li>\n        Inspect the solar panels\n        <ul>\n          <li>Tomas Okafor</li>\n          <li>Ines Lindqvist</li>\n        </ul>\n      </li>\n      <li>Harvest the greenhouse</li>\n      <li>Log the day's dockings</li>\n    </ol>\n  </body>\n</html>"
      },
