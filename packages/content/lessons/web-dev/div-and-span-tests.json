{
  "cases": [
    {
      "name": "The cards are grouped in one box",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "exists": "#cards",
          "label": "a box with id=\"cards\""
        },
        {
          "count": "#cards > .card",
          "atLeast": 4,
          "label": "cards (class=\"card\") inside #cards"
        }
      ]
    },
    {
      "name": "Each card has a name and a job",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "count": "#cards > .card:not(:has(h3))",
          "equals": 0,
          "label": "cards without a name in a third-level heading (<h3>)"
        },
        {
          "count": "#cards > .card:not(:has(p span.role))",
          "equals": 0,
          "label": "cards without a job in a <span class=\"role\"> inside a paragraph"
        },
        {
          "text": ".card h3",
          "nonEmpty": true,
          "label": "a crew member's name"
        },
        {
          "text": ".card span.role",
          "nonEmpty": true,
          "label": "a crew member's job"
        }
      ]
    },
    {
      "name": "A job sits inside its line of text",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "style": ".card span.role",
          "prop": "display",
          "equals": "inline",
          "label": "a job (<span class=\"role\">)"
        },
        {
          "style": ".card",
          "prop": "display",
          "equals": "block",
          "label": "a card"
        }
      ]
    }
  ]
}
