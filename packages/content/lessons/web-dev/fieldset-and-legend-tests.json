{
  "cases": [
    {
      "name": "The seats are a group with a question over it",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "exists": "fieldset:has(input[name=\"seat\"][value=\"window\"]):has(input[name=\"seat\"][value=\"aisle\"]):not(:has(input[name=\"extras\"]))",
          "label": "a group (fieldset) that holds the two seats and no extras"
        },
        {
          "text": "fieldset:has(input[name=\"seat\"][value=\"window\"]):has(input[name=\"seat\"][value=\"aisle\"]):not(:has(input[name=\"extras\"])) > legend",
          "nonEmpty": true,
          "label": "a question (legend) over the group of seats"
        }
      ]
    },
    {
      "name": "The extras are a group with a question over it",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "exists": "fieldset:has(input[name=\"extras\"][value=\"meal\"]):has(input[name=\"extras\"][value=\"blanket\"]):has(input[name=\"extras\"][value=\"wifi\"]):not(:has(input[name=\"seat\"]))",
          "label": "a group (fieldset) that holds the three extras and no seat"
        },
        {
          "text": "fieldset:has(input[name=\"extras\"][value=\"meal\"]):has(input[name=\"extras\"][value=\"blanket\"]):has(input[name=\"extras\"][value=\"wifi\"]):not(:has(input[name=\"seat\"])) > legend",
          "nonEmpty": true,
          "label": "a question (legend) over the group of extras"
        }
      ]
    },
    {
      "name": "The choices still work and are sent",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "click": "label:has(input[name=\"seat\"][value=\"aisle\"]), input[name=\"seat\"][value=\"aisle\"] + label, label:has(+ input[name=\"seat\"][value=\"aisle\"])",
          "label": "the label of the aisle seat"
        },
        {
          "click": "label:has(input[name=\"extras\"][value=\"blanket\"]), input[name=\"extras\"][value=\"blanket\"] + label, label:has(+ input[name=\"extras\"][value=\"blanket\"])",
          "label": "the label of the blanket box"
        },
        {
          "exists": "form:has(#passenger):valid",
          "label": "the booking form ready to be sent, with no box the browser refuses"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "sent": {
            "seat": "aisle",
            "extras": "blanket"
          }
        },
        {
          "sent": {
            "extras": "wifi"
          }
        }
      ]
    },
    {
      "name": "Other choices",
      "page": "boarding.html",
      "steps": [
        {
          "click": "label:has(input[name=\"seat\"][value=\"window\"]), input[name=\"seat\"][value=\"window\"] + label, label:has(+ input[name=\"seat\"][value=\"window\"])",
          "label": "the label of the window seat"
        },
        {
          "click": "label:has(input[name=\"extras\"][value=\"meal\"]), input[name=\"extras\"][value=\"meal\"] + label, label:has(+ input[name=\"extras\"][value=\"meal\"])",
          "label": "the label of the hot meal box"
        },
        {
          "click": "label:has(input[name=\"extras\"][value=\"wifi\"]), input[name=\"extras\"][value=\"wifi\"] + label, label:has(+ input[name=\"extras\"][value=\"wifi\"])",
          "label": "the label of the Wi-Fi box"
        },
        {
          "exists": "form:has(#passenger):valid",
          "label": "the booking form ready to be sent, with no box the browser refuses"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "sent": {
            "seat": "window",
            "extras": "meal"
          }
        }
      ]
    }
  ]
}
