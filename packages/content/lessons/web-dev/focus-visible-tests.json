{
  "cases": [
    {
      "name": "Tab shows a clear ring on the next box",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "press": "Tab",
          "on": "#passenger",
          "label": "the name box"
        },
        {
          "style": "#email",
          "prop": "outline-width",
          "atLeast": 2,
          "label": "the email box, reached with Tab"
        },
        {
          "style": "#email",
          "prop": "outline-style",
          "not": "auto",
          "label": "the email box, reached with Tab"
        },
        {
          "style": "#email",
          "prop": "outline-style",
          "not": "none",
          "label": "the email box, reached with Tab"
        }
      ]
    },
