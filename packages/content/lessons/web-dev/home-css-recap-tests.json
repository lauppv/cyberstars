{
  "cases": [
    {
      "name": "The hours have the class hours",
      "visible": true,
      "steps": [
        {
          "exists": "h2#visiting + p.hours",
          "label": "the hours, right under Visiting Hours (<p class=\"hours\">)"
        }
      ]
    },
    {
      "name": "The hours stand on a panel of their own",
      "visible": true,
      "steps": [
        {
          "differs": ".hours",
          "from": "p:not(.hours):not(.warning)",
          "props": ["background-color"],
          "fromLabel": "the other paragraphs",
          "label": "the hours"
        }
      ]
    },
    {
      "name": "The hours are in a monospace font, centered",
      "visible": true,
      "steps": [
        {
          "style": ".hours",
          "prop": "font-family",
          "endsWith": "monospace",
          "label": "the hours"
        },
        {
          "style": ".hours",
          "prop": "text-align",
          "equals": "center",
          "label": "the hours"
        }
      ]
    },
    {
      "name": "The hours read easily",
      "visible": true,
      "steps": [
        {
          "contrast": ".hours",
          "atLeast": 4.5,
          "label": "the hours"
        }
      ]
    }
  ]
}
