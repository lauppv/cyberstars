{
  "cases": [
    {
      "name": "The hours are a card of their own",
      "visible": true,
      "steps": [
        {
          "text": "#visiting + p.hours",
          "contains": "Monday to Friday",
          "label": "the hours, in the class hours, right under Visiting Hours"
        },
        {
          "style": "p.hours",
          "prop": "background-color",
          "not": "rgba(0, 0, 0, 0)",
          "label": "the hours"
        },
        {
          "differs": "p.hours",
          "from": "body",
          "props": ["background-color"],
          "fromLabel": "the page",
          "label": "the hours"
        },
        {
          "contrast": "p.hours",
          "atLeast": 4.5,
          "label": "the hours"
        }
      ]
    },
    {
      "name": "The hours are set like a station terminal",
      "visible": true,
      "steps": [
        {
          "style": "p.hours",
          "prop": "font-family",
          "endsWith": "monospace",
          "label": "the hours"
        },
        {
          "differs": "p:not(.hours)",
          "from": "p.hours",
          "props": ["font-family"],
          "fromLabel": "the hours",
          "label": "the other paragraphs"
        }
      ]
    },
    {
      "name": "Visiting Hours stands out from the other sections",
      "visible": true,
      "steps": [
        {
          "differs": "#visiting",
          "from": "h2:not(#visiting)",
          "props": ["color", "background-color"],
          "fromLabel": "the other section headings",
          "label": "the heading Visiting Hours"
        },
        {
          "contrast": "#visiting",
          "atLeast": 3,
          "label": "the heading Visiting Hours"
        }
      ]
    },
    {
      "name": "The jump links sit in the middle",
      "visible": true,
      "steps": [
        {
          "exists": "p.jumps a[href=\"#today\"]",
          "label": "the jump links' paragraph, in the class jumps"
        },
        {
          "centered": "p.jumps a",
          "label": "the jump links"
        }
      ]
    }
  ]
}
