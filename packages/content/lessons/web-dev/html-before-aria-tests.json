{
  "cases": [
    {
      "name": "The settings page is a page like the others",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "doctype": true
        },
        {
          "attr": "html",
          "name": "lang",
          "equals": "en",
          "label": "the page's language (lang on <html>)"
        },
        {
          "text": "head > title",
          "nonEmpty": true,
          "label": "the tab's name (<title>)"
        },
        {
          "count": "h1",
          "equals": 1,
          "label": "biggest headings (<h1>)"
        },
        {
          "exists": "body > header:first-child",
          "label": "a header (<header>) at the very top of the page"
        },
        {
          "exists": "body > main h1",
          "label": "the page's content in <main>, with its heading"
        },
        {
          "text": "body > footer:last-child",
          "contains": "Docking Ring B",
          "label": "the footer (<footer>) at the very end of the page"
        },
        {
          "hidden": "header nav",
          "label": "the menu (the nav in the header)"
        },
        {
          "click": "#menu-button",
          "label": "the button #menu-button"
        },
        {
          "visible": "header nav",
          "label": "the menu (the nav in the header)"
        },
        {
          "outline": true
        }
      ]
    },
    {
      "name": "Three real buttons for the theme",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "exists": "main #theme-buttons",
          "label": "the box of theme buttons (#theme-buttons) in the main part"
        },
        {
          "exists": "#theme-buttons > button#theme-light[type=\"button\"]",
          "label": "the Light button (a <button type=\"button\"> with the id theme-light)"
        },
        {
          "exists": "#theme-buttons > button#theme-dark[type=\"button\"]",
          "label": "the Dark button (a <button type=\"button\"> with the id theme-dark)"
        },
        {
          "exists": "#theme-buttons > button#theme-system[type=\"button\"]",
          "label": "the System button (a <button type=\"button\"> with the id theme-system)"
        },
        {
          "text": "#theme-light",
          "contains": "Light",
          "label": "the Light button"
        },
        {
          "text": "#theme-dark",
          "contains": "Dark",
          "label": "the Dark button"
        },
        {
          "text": "#theme-system",
          "contains": "System",
          "label": "the System button"
        },
        {
          "order": ["main h2", "#theme-buttons"],
          "label": "a heading, then the theme buttons"
        },
        {
          "press": "Tab",
          "on": "#theme-light",
          "label": "the Light button"
        },
        {
          "focused": "#theme-dark",
          "label": "the Dark button, after pressing Tab on the Light button"
        }
      ]
    },
    {
