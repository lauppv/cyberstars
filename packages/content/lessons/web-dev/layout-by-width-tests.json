          "label": "the crew's card"
        },
        {
          "size": "#crew-count",
          "maxHeight": 210,
          "label": "the crew's card"
        },
        {
          "layout": ".week > li:nth-child(1), .week > li:nth-child(2), .week > li:nth-child(3), .week > li:nth-child(4)",
          "arrange": "row",
          "label": "Monday to Thursday"
