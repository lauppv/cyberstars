  "cases": [
    {
      "name": "On a phone, the cards one under the other",
      "visible": true,
      "width": 375,
      "steps": [
        {
          "open": "dashboard.html"
        },
        {
          "layout": ".stats > .stat",
          "arrange": "column",
          "gap": 16,
          "label": "the cards"
        },
        {
          "against": "#next-launch",
