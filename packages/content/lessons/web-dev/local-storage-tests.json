{
  "cases": [
    {
      "name": "The chosen theme is still there after a reload",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "click": "#theme-dark",
          "label": "the Dark button"
        },
        {
          "open": "settings.html"
        },
        {
          "text": "#current-theme",
          "equals": "Theme: Dark",
          "label": "the paragraph #current-theme"
        },
        {
          "attr": "#theme-dark",
          "name": "aria-pressed",
          "equals": "true",
          "label": "the Dark button (#theme-dark)"
        },
        {
          "attr": "#theme-system",
          "name": "aria-pressed",
          "equals": "false",
          "label": "the System button (#theme-system)"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "A visitor who saved Light before",
      "visible": true,
      "page": "settings.html",
      "storage": {
        "theme": "light"
      },
      "steps": [
        {
          "text": "#current-theme",
          "equals": "Theme: Light",
          "label": "the paragraph #current-theme"
        },
        {
          "attr": "#theme-light",
          "name": "aria-pressed",
          "equals": "true",
          "label": "the Light button (#theme-light)"
        }
      ]
    },
    {
      "name": "A first visit starts as in the HTML",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "text": "#current-theme",
          "equals": "Theme: Same as my device",
          "label": "the paragraph #current-theme"
        },
        {
          "attr": "#theme-system",
          "name": "aria-pressed",
          "equals": "true",
          "label": "the System button (#theme-system)"
        }
      ]
    },
    {
      "name": "The last choice counts",
      "page": "settings.html",
      "storage": {
        "theme": "dark"
      },
      "steps": [
        {
          "text": "#current-theme",
          "equals": "Theme: Dark",
          "label": "the paragraph #current-theme"
        },
        {
          "click": "#theme-system",
          "label": "the System button"
        },
        {
          "click": "#theme-light",
          "label": "the Light button"
        },
        {
          "open": "settings.html"
        },
        {
          "text": "#current-theme",
          "equals": "Theme: Light",
          "label": "the paragraph #current-theme"
        }
      ]
    },
    {
      "name": "An imported theme is kept too",
      "page": "settings.html",
      "steps": [
        {
          "fill": "#import",
          "text": "{\"theme\":\"dark\",\"motion\":\"full\"}",
          "label": "the box #import"
        },
        {
          "click": "#import-button",
          "label": "the button #import-button"
        },
        {
          "open": "settings.html"
        },
        {
          "text": "#current-theme",
          "equals": "Theme: Dark",
          "label": "the paragraph #current-theme"
        }
      ]
    }
  ]
}
