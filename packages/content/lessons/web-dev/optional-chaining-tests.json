utton>\n          <button type=\"button\" id=\"motion-less\" aria-pressed=\"true\"><span aria-hidden=\"true\">◌</span> Less</button>\n        </div>\n        <p id=\"current-motion\"></p>\n      </section>\n    </div>\n    </main>\n\n    <footer>\n      <p>Orbital Station 7 · Docking Ring B · Low Earth Orbit</p>\n      <p>Written by the crew, for everyone on board and back on Earth.</p>\n    </footer>\n  </body>\n</html>\n"
