{
  "cases": [
    {
      "name": "Every card has a bio",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "count": "#cards > .card > p.bio:not(:empty)",
          "atLeast": 4,
          "label": "cards with a bio (<p class=\"bio\">)"
        }
      ]
    },
    {
      "name": "A bio is at most 100 pixels tall",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "size": "#cards > .card:nth-child(1) .bio",
          "maxHeight": 100,
          "label": "the bio of card 1"
        },
        {
          "size": "#cards > .card:nth-child(2) .bio",
          "maxHeight": 100,
          "label": "the bio of card 2"
        },
        {
          "size": "#cards > .card:nth-child(3) .bio",
          "maxHeight": 100,
          "label": "the bio of card 3"
        },
        {
          "size": "#cards > .card:nth-child(4) .bio",
          "maxHeight": 100,
          "label": "the bio of card 4"
        }
      ]
    },
    {
      "name": "A long bio scrolls inside its box",
      "visible": true,
      "page": "crew.html",
      "steps": [
        {
          "style": ".bio",
          "prop": "overflow-y",
          "every": true,
          "not": "visible",
          "label": "every bio"
        },
        {
          "style": ".bio",
          "prop": "overflow-y",
          "every": true,
          "not": "hidden",
          "label": "every bio"
        }
      ]
    }
  ]
}
