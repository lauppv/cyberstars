{
  "cases": [
    {
      "name": "A booking with a right badge number goes through",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "fill": "#passenger",
          "text": "Ida Moreau",
          "label": "the name box"
        },
        {
          "fill": "#email",
          "text": "ida@example.com",
          "label": "the email box"
        },
        {
          "select": "#flight",
          "option": "SL-102",
          "label": "the flight list"
        },
        {
          "fill": "#travel-date",
          "text": "2031-05-14",
          "label": "the date box"
        },
        {
          "fill": "#badge-number",
          "text": "OS4821",
          "label": "the badge number box"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "text": "#confirmation",
          "equals": "Seat booked for Ida Moreau on SL-102",
          "label": "the confirmation (#confirmation)"
        },
        {
          "count": "#badge-number:invalid",
          "equals": 0,
          "label": "badge number boxes the browser refuses"
        },
        {
          "noErrors": true
        }
      ]
    },
    {
      "name": "The browser refuses a badge number that breaks the rule",
