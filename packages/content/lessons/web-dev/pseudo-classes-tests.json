{
  "cases": [
    {
      "name": "The flights have zebra stripes",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "differs": "#flights tbody tr:nth-child(even) td:first-child",
          "from": "#flights tbody tr:nth-child(odd) td:first-child",
          "props": ["background-color"],
          "fromLabel": "the odd rows",
          "label": "the even rows"
        },
        {
          "contrast": "#flights tbody tr:nth-child(even) td",
          "atLeast": 4.5,
          "every": true,
          "label": "a cell of an even row"
        }
      ]
    },
    {
      "name": "A row lights up under the mouse",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "hover": "#flights tbody tr:nth-child(3)",
          "label": "the third flight"
        },
        {
          "differs": "#flights tbody tr:nth-child(3) td:first-child",
          "from": "#flights tbody tr:not(:nth-child(3)) td:first-child",
          "props": ["background-color"],
          "fromLabel": "the other rows",
          "label": "the third flight, under the mouse"
        },
        {
          "hover": "#flights tbody tr:nth-child(4)",
          "label": "the fourth flight"
        },
        {
          "differs": "#flights tbody tr:nth-child(4) td:first-child",
          "from": "#flights tbody tr:not(:nth-child(4)) td:first-child",
          "props": ["background-color"],
          "fromLabel": "the other rows",
          "label": "the fourth flight, under the mouse"
        },
        {
          "contrast": "#flights tbody tr:nth-child(4) td",
          "atLeast": 4.5,
          "every": true,
          "label": "a cell of the row under the mouse"
        }
      ]
    },
    {
      "name": "A navigation link lights up under the mouse",
      "visible": true,
      "steps": [
        {
          "hover": "nav a[href=\"crew.html\"]",
          "label": "the link Crew"
        },
        {
          "differs": "nav a[href=\"crew.html\"]",
          "from": "nav a:not([href=\"crew.html\"])",
          "props": ["color", "background-color", "text-decoration-line", "border-bottom-color"],
          "fromLabel": "the other links of the navigation",
          "label": "the link Crew, under the mouse"
        }
      ]
    },
    {
      "name": "The keyboard's focus is easy to see",
      "visible": true,
      "steps": [
        {
          "press": "Tab",
          "on": "nav a[href=\"crew.html\"]"
        },
        {
          "press": "Shift+Tab"
        },
        {
          "style": "nav a[href=\"crew.html\"]",
          "prop": "outline-style",
          "not": "none",
          "label": "the link Crew, with the keyboard's focus"
        },
        {
          "style": "nav a[href=\"crew.html\"]",
          "prop": "outline-width",
          "atLeast": 2,
          "label": "the link Crew, with the keyboard's focus"
        }
      ]
    }
  ]
}
