        },
        {
          "style": "h2",
          "pseudo": "::after",
          "prop": "display",
          "equals": "block",
          "label": "the bar after a section heading"
        },
        {
          "style": "h2",
          "pseudo": "::after",
          "prop": "width",
          "equals": "48px",
          "label": "the bar after a section heading"
        },
        {
          "style": "h2",
          "pseudo": "::after",
          "prop": "height",
          "equals": "3px",
          "label": "the bar after a section heading"
        },
        {
          "style": "h2",
          "pseudo": "::after",
          "prop": "margin-top",
          "equals": "6px",
          "label": "the bar after a section heading"
        },
        {
          "style": "h2",
          "pseudo": "::after",
          "prop": "background-color",
          "equals": "rgb(255, 209, 102)",
          "label": "the bar after a section heading"
        }
