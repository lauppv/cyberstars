{
  "cases": [
    {
      "name": "Links to other sites end with an arrow",
      "visible": true,
      "steps": [
        {
          "style": "a[href^=\"https://\"]",
          "pseudo": "::after",
          "prop": "content",
          "equals": "\" ↗\"",
          "label": "the end of a link to another site"
        },
        {
          "style": "p.jumps a",
          "pseudo": "::after",
          "prop": "content",
          "equals": "none",
          "label": "the end of a jump link"
        }
      ]
    },
    {
      "name": "Warnings start with a sign",
      "visible": true,
      "steps": [
        {
          "style": "p.warning",
          "pseudo": "::before",
          "prop": "content",
          "equals": "\"⚠ \"",
          "label": "the start of a warning"
        },
        {
          "text": "p.warning strong",
          "nonEmpty": true,
          "label": "a warning's important part, still in the HTML"
        }
      ]
    },
    {
      "name": "Section headings have a gold bar under them",
