{
  "cases": [
    {
      "name": "A badge number that keeps the rule shows on the pass",
      "visible": true,
      "page": "boarding.html",
      "steps": [
        {
          "exists": "form#booking input#badge-number[name=\"badge\"]",
          "label": "a box with id=\"badge-number\" and name=\"badge\" in the form"
        },
        {
          "exists": "label[for=\"badge-number\"]",
          "label": "the label of the badge number box"
        },
        {
          "order": [
            "#email",
            "label[for=\"badge-number\"]",
            "#badge-number",
            "label[for=\"phone\"]"
          ],
          "label": "the email box, then the label and the box of the badge number, then the label of the phone box"
        },
        {
          "text": "#pass-badge",
          "equals": "No valid badge yet",
          "label": "the badge number on the pass at the start (#pass-badge)"
        },
        {
          "fill": "#badge-number",
          "text": "OS4821",
          "label": "the badge number box"
        },
        {
          "text": "#pass-badge",
          "equals": "OS4821",
          "label": "the badge number on the pass (#pass-badge)"
        },
        {
          "noErrors": true
        }
      ]
    },
