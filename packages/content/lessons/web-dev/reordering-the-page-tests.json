          "label": "the button (<button id=\"sort-by-time\">)"
        },
        {
          "click": "button#sort-by-time",
          "label": "the button Sort by time"
        },
        {
          "text": "#flights tbody tr:nth-child(1) .code",
          "equals": "SL-103",
          "label": "the first flight after sorting"
        },
        {
          "text": "#flights tbody tr:nth-child(2) .code",
          "equals": "SL-101",
          "label": "the second flight"
        },
        {
          "text": "#flights tbody tr:nth-child(5) .code",
          "equals": "SL-104",
          "label": "the last flight"
        }
      ]
    },
    {
      "name": "The rows move, with their classes",
