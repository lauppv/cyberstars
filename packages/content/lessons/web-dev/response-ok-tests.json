{
  "cases": [
    {
      "name": "An answer that is an error is said on the line",
      "visible": true,
      "page": "tracker.html",
      "fetch": {
        "https://cyberstars.app/api/practice/starships": {
          "body": "{\"error\": \"Down for repairs\"}",
          "status": 500
