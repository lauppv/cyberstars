{
  "cases": [
    {
      "name": "Under the mouse, a theme button's icon turns",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "style": "#theme-light span",
          "prop": "transform",
          "equals": "none",
          "label": "the Light button's icon, without the mouse over it"
        },
        {
          "hover": "#theme-light",
          "label": "the Light button"
        },
        {
          "style": "#theme-light span",
          "prop": "transform",
          "not": "none",
          "label": "the Light button's icon, under the mouse"
        },
        {
          "style": "#theme-light span",
          "prop": "display",
          "not": "inline",
          "label": "the Light button's icon, a box that can turn (not inline)"
        },
        {
          "style": "#theme-light",
          "prop": "transform",
          "equals": "none",
          "label": "the Light button itself, under the mouse"
        },
        {
          "hover": "#theme-dark",
          "label": "the Dark button"
        },
        {
          "style": "#theme-dark span",
          "prop": "transform",
          "not": "none",
          "label": "the Dark button's icon, under the mouse"
        },
        {
          "style": "#theme-light span",
          "prop": "transform",
          "equals": "none",
          "label": "the Light button's icon, once the mouse left"
        }
      ]
    },
    {
      "name": "The pressed theme button is 10% bigger",
      "visible": true,
      "page": "settings.html",
      "steps": [
        {
          "style": "#theme-system",
          "prop": "transform",
          "equals": "matrix(1.1, 0, 0, 1.1, 0, 0)",
          "label": "the pressed System button"
        },
        {
          "style": "#theme-light",
          "prop": "transform",
          "equals": "none",
          "label": "the Light button, not pressed"
        }
      ]
    },
    {
      "name": "Whichever button is pressed",
      "page": "settings.html",
      "files": {
        "settings.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content=\"Pick how the station's website looks for you: light or dark, with more or less movement.\" />\n    <title>Settings</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script src=\"menu.js\" defer></script>\n  </head>\n  <body>\n    <header>\n      <p class=\"site-name\">Orbital Station 7</p>\n      <button type=\"button\" id=\"menu-button\" aria-expanded=\"false\">Menu</button>\n      <nav aria-label=\"Main menu\">\n        <a href=\"index.html\">Home</a>\n        <a href=\"crew.html\">Crew</a>\n        <a href=\"schedule.html\">Schedule</a>\n        <a href=\"boarding.html\">Boarding</a>\n        <a href=\"wiki.html\">Wiki</a>\n        <a href=\"dashboard.html\">Dashboard</a>\n        <a href=\"settings.html\">Settings</a>\n      </nav>\n    </header>\n    <main>\n    <h1>Settings</h1>\n    <p>Make the station's website yours. Your choice is for this browser only.</p>\n\n    <section>\n      <h2>Theme</h2>\n      <div id=\"theme-buttons\">\n        <button type=\"button\" id=\"theme-light\" aria-pressed=\"false\"><span aria-hidden=\"true\">☀</span> Light</button>\n        <button type=\"button\" id=\"theme-dark\" aria-pressed=\"true\"><span aria-hidden=\"true\">☾</span> Dark</button>\n        <button type=\"button\" id=\"theme-system\" aria-pressed=\"false\">System</button>\n      </div>\n    </section>\n\n    <section>\n      <h2>Motion</h2>\n      <p>Less motion stops the animations on every page.</p>\n      <div id=\"motion-buttons\">\n        <button type=\"button\" id=\"motion-full\" aria-pressed=\"true\"><span aria-hidden=\"true\">✦</span> Full</button>\n        <button type=\"button\" id=\"motion-less\" aria-pressed=\"false\"><span aria-hidden=\"true\">◌</span> Less</button>\n      </div>\n    </section>\n    </main>\n\n    <footer>\n      <p>Orbital Station 7 · Docking Ring B · Low Earth Orbit</p>\n      <p>Written by the crew, for everyone on board and back on Earth.</p>\n    </footer>\n  </body>\n</html>\n"
      },
      "steps": [
        {
          "style": "#theme-dark",
          "prop": "transform",
          "equals": "matrix(1.1, 0, 0, 1.1, 0, 0)",
          "label": "the pressed Dark button"
        },
        {
          "style": "#theme-system",
          "prop": "transform",
          "equals": "none",
          "label": "the System button, not pressed"
