{
  "cases": [
    {
      "name": "The delayed flight's status stands out",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "text": "#flights tbody tr.delayed td.status",
          "equals": "Delayed",
          "label": "the status of the row with class=\"delayed\""
        },
        {
          "differs": "#flights tr.delayed td.status",
          "from": "#flights tr:not(.delayed) td.status",
          "props": ["color", "background-color"],
          "fromLabel": "the other statuses",
          "label": "the status of the delayed flight"
        },
        {
          "contrast": "#flights tr.delayed td.status",
          "atLeast": 4.5,
          "label": "the status of the delayed flight"
        }
      ]
    },
    {
      "name": "Every status is bold, the cancelled one marked",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "style": "#flights td.status",
          "prop": "font-weight",
          "equals": "700",
          "label": "every status cell",
          "every": true
        },
        {
          "style": "#flights td:not(.status)",
          "prop": "font-weight",
          "equals": "400",
          "label": "every other cell",
          "every": true
        },
        {
          "style": "#flights tr.cancelled td.status",
          "pseudo": "::before",
          "prop": "content",
          "equals": "\"✕ \"",
          "label": "the start of the cancelled flight's status"
        },
        {
          "style": "#flights tr.delayed td.status",
          "pseudo": "::before",
          "prop": "content",
          "equals": "none",
          "label": "the start of the delayed flight's status"
        }
      ]
    },
    {
      "name": "The bays table belongs with the flights table",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "style": "#bays",
          "prop": "border-collapse",
          "equals": "collapse",
          "label": "the bays table"
        },
        {
          "fills": "#bays",
          "label": "the bays table"
        },
        {
          "style": "#bays td",
          "prop": "padding-top",
          "atLeast": 4,
          "every": true,
          "label": "a cell of the bays table"
        },
        {
          "style": "#bays td",
          "prop": "padding-right",
          "atLeast": 4,
          "every": true,
          "label": "a cell of the bays table"
        },
        {
          "style": "#bays td",
          "prop": "padding-bottom",
          "atLeast": 4,
          "every": true,
          "label": "a cell of the bays table"
        },
        {
          "style": "#bays td",
          "prop": "padding-left",
          "atLeast": 4,
          "every": true,
          "label": "a cell of the bays table"
        },
        {
          "style": "#bays td",
          "prop": "border-bottom-width",
          "atLeast": 1,
          "every": true,
          "label": "a cell of the bays table"
        }
      ]
    },
    {
      "name": "The banner keeps its distance",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "layout": ".banner, .banner + *",
          "arrange": "column",
          "gap": 12,
          "label": "the banner and what comes after it"
        }
      ]
    }
  ]
}
