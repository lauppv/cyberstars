{
  "cases": [
    {
      "name": "script.js is linked in the head, deferred",
      "visible": true,
      "steps": [
        {
          "exists": "head script[src=\"script.js\"], head script[src=\"./script.js\"]",
          "label": "a script.js linked from the head"
        },
        {
          "exists": "head script[src$=\"script.js\"][defer]",
          "label": "that script waiting for the whole page (defer)"
        }
      ]
    },
    {
      "name": "The script draws a line along the top",
      "visible": true,
      "steps": [
        {
          "noErrors": true
        },
        {
          "style": "body",
          "prop": "border-top-width",
          "atLeast": 4,
          "label": "the page's body"
        },
        {
          "style": "body",
          "prop": "border-top-style",
          "not": "none",
          "label": "the page's body"
        }
      ]
    },
    {
      "name": "Without the script, there is no line",
      "visible": false,
      "files": {
        "script.js": "// nothing\n"
      },
      "steps": [
        {
          "style": "body",
          "prop": "border-top-width",
          "equals": "0px",
          "label": "the page's top border"
        }
      ]
    }
  ]
}
