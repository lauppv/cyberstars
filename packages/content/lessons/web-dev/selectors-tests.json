{
  "cases": [
    {
      "name": "Both warnings have the class warning",
      "visible": true,
      "steps": [
        {
          "count": "p.warning",
          "atLeast": 2,
          "label": "warning paragraphs (<p class=\"warning\">)"
        }
      ]
    },
    {
      "name": "Warnings have a color the other paragraphs don't have",
      "visible": true,
      "steps": [
        {
          "differs": ".warning",
          "from": "p:not(.warning)",
          "props": ["color"],
          "fromLabel": "the other paragraphs",
          "label": "the warnings"
        }
      ]
    }
  ]
}
