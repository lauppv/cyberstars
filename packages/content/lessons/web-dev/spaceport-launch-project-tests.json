    {
      "name": "With other trips",
      "visible": false,
      "files": {
        "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content=\"Trips to watch a launch, from Lyra Spaceport.\" />\n    <title>Lyra Spaceport</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script src=\"script.js\" defer></script>\n  </head>\n  <body>\n    <header>\n      <h1>Lyra Spaceport</h1>\n      <button type=\"button\" id=\"menu-button\" aria-expanded=\"false\">Menu</button>\n      <nav id=\"menu\" aria-label=\"Main menu\">\n        <a href=\"#trips\">Trips</a>\n        <a href=\"#visit\">Your visit</a>\n        <a href=\"#contact\">Contact</a>\n      </nav>\n    </header>\n    <main>\n      <section id=\"trips\">\n        <h2>Trips &amp; prices</h2>\n        <p>Watch a real rocket launch from our stands, 4&nbsp;km from the pad. Pick a trip, and we keep a seat for you.</p>\n        <div class=\"trip-list\">\n          <article class=\"trip\">\n            <h3>Morning Stands</h3>\n            <p>€29</p>\n            <p>A seat on the stands.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Rocket Garden</h3>\n            <p>€19</p>\n            <p>Walk between real rockets that flew, and read the story of each one on the boards beside it. A guide answers your questions, and children get a map with a game on it.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <span class=\"badge\">Best seller</span>\n            <h3>Night Watch</h3>\n            <p>€62</p>\n            <p>The launch at night, from the roof.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>School Group</h3>\n            <p>€15</p>\n            <p>For a class with its teacher.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Sunrise over the Sea</h3>\n            <p>€75</p>\n            <p>A boat takes you out at dawn, and you watch the launch from the water, far from the crowds, with breakfast on board and a guide who talks you through the countdown.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Pad Tour</h3>\n            <p>€99</p>\n            <p>A bus ride round the pads.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Mission Control</h3>\n            <p>€180</p>\n            <p>A day beside the people who fly the rocket.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n        </div>\n      </section>\n      <aside id=\"visit\">\n        <h2>Your visit</h2>\n        <p id=\"choice\">No trip chosen yet</p>\n        <h3>What to bring</h3>\n        <ul>\n          <li>Ear plugs: a launch is loud</li>\n          <li>A warm jacket for the night</li>\n          <li>Water and a snack</li>\n        </ul>\n      </aside>\n    </main>\n    <footer id=\"contact\">\n      <p>Lyra Spaceport, 12 Coast Road</p>\n      <p><a href=\"mailto:visit@lyra-spaceport.test\">visit@lyra-spaceport.test</a></p>\n    </footer>\n  </body>\n</html>\n"
      },
