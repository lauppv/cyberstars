        "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content=\"Watch a rocket launch from the stands of Lyra Spaceport.\" />\n    <title>Lyra Spaceport</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script src=\"script.js\" defer></script>\n  </head>\n  <body>\n    <header>\n      <h1>Lyra Spaceport</h1>\n      <button type=\"button\" id=\"menu-button\" aria-expanded=\"false\">Menu</button>\n      <nav id=\"menu\" aria-label=\"Main menu\">\n        <a href=\"#trips\">Trips</a>\n        <a href=\"#visit\">Your visit</a>\n        <a href=\"#contact\">Contact</a>\n      </nav>\n    </header>\n    <main>\n      <section id=\"trips\">\n        <h2>Trips &amp; prices</h2>\n        <p>Watch a real rocket launch from our stands, 4&nbsp;km from the pad. Pick a trip, and we keep a seat for you.</p>\n        <div class=\"trip-list\">\n          <article class=\"trip\">\n            <h3>Trip 1</h3>\n            <p>€21</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 2</h3>\n            <p>€22</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 3</h3>\n            <p>€23</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <span class=\"badge\">Best seller</span>\n            <h3>Trip 4</h3>\n            <p>€24</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 5</h3>\n            <p>€25</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 6</h3>\n            <p>€26</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 7</h3>\n            <p>€27</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 8</h3>\n            <p>€28</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 9</h3>\n            <p>€29</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n          <article class=\"trip\">\n            <h3>Trip 10</h3>\n            <p>€30</p>\n            <p>A seat on the stands with a guide, who explains every step of the countdown to you.</p>\n            <button type=\"button\">Choose</button>\n          </article>\n        </div>\n      </section>\n      <aside id=\"visit\">\n        <h2>Your visit</h2>\n        <p id=\"choice\">No trip chosen yet</p>\n        <h3>What to bring</h3>\n        <ul>\n          <li>Ear plugs: a launch is loud</li>\n          <li>A warm jacket for the night</li>\n          <li>Water and a snack</li>\n        </ul>\n      </aside>\n    </main>\n    <footer id=\"contact\">\n      <p>Lyra Spaceport, 12 Coast Road</p>\n      <p><a href=\"mailto:visit@lyra-spaceport.test\">visit@lyra-spaceport.test</a></p>\n    </footer>\n  </body>\n</html>\n"
