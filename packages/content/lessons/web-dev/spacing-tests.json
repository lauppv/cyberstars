          "arrange": "column",
          "label": "the new box and the label under it",
          "gap": 16
        },
        {
          "layout": "fieldset:has(#seat-window), fieldset:has(#extra-meal)",
          "arrange": "column",
          "label": "the group of seats and the group of extras",
          "gap": 16
        },
        {
