          "label": "the name box"
        },
        {
          "fill": "#email",
          "text": "ida@example.com",
          "label": "the email box"
        },
        {
          "select": "#flight",
          "option": "SL-102",
          "label": "the flight list"
        },
        {
          "fill": "#travel-date",
          "text": "2031-05-14",
          "label": "the date box"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "logged": "Sending the booking for Ida Moreau"
        },
        {
          "sent": {
            "passenger": "Ida Moreau",
            "flight": "SL-102"
          }
        },
        {
          "noErrors": true
        }
      ]
    },
