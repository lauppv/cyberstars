{
  "cases": [
    {
      "name": "schedule.html is a whole page of the site",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "doctype": true
        },
        {
          "exists": "html[lang|=\"en\" i]",
          "label": "the <html> tag with lang set to English"
        },
        {
          "attr": "head meta[charset]",
          "name": "charset",
          "equals": "UTF-8",
          "ignoreCase": true,
          "label": "a <meta> tag in the <head>"
        },
        {
          "text": "head > title",
          "nonEmpty": true,
          "label": "a <title> in the <head>"
        },
        {
          "text": "h1",
          "nonEmpty": true,
          "label": "the biggest heading"
        },
        {
          "style": "body",
          "prop": "background-color",
          "equals": "rgb(11, 29, 58)",
          "label": "the page (<body>)"
        }
      ]
    },
    {
      "name": "The flights table has a row per flight, four cells each",
      "visible": true,
      "page": "schedule.html",
      "steps": [
        {
          "count": "#flights tr:has(> td:nth-child(4))",
          "atLeast": 5,
          "label": "rows of four cells in the table with the id flights"
        },
        {
          "text": "#flights tr:has(> td) > td:first-child",
          "equals": "SL-101",
          "label": "the first cell of a row"
        },
        {
          "text": "#flights",
          "contains": "Lunar Gateway 11:00 Cancelled",
          "label": "the flights table"
        }
      ]
    },
    {
      "name": "Every menu leads to the schedule",
      "visible": true,
      "steps": [
        {
          "click": "nav a[href$=\"schedule.html\"]",
          "label": "the menu link to the schedule"
        },
        {
          "at": "schedule.html"
        },
        {
          "open": "crew.html"
        },
        {
          "click": "nav a[href$=\"schedule.html\"]",
          "label": "the menu link to the schedule"
        },
        {
          "at": "schedule.html"
        },
        {
          "open": "people/vega.html"
        },
        {
          "click": "nav a[href$=\"schedule.html\"]",
          "label": "the menu link to the schedule"
        },
        {
          "at": "schedule.html"
        }
      ]
    }
  ]
}
