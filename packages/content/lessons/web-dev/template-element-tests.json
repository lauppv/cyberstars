{
  "cases": [
    {
      "name": "The tracker is a page like the others",
      "visible": true,
      "page": "tracker.html",
      "steps": [
        {
          "doctype": true
        },
        {
          "attr": "html",
          "name": "lang",
          "equals": "en",
          "label": "the page's language (lang on <html>)"
        },
        {
          "text": "head > title",
          "nonEmpty": true,
          "label": "the tab's name (<title>)"
        },
        {
          "count": "h1",
          "equals": 1,
          "label": "biggest headings (<h1>)"
        },
        {
          "exists": "body > header:first-child",
          "label": "a header (<header>) at the very top of the page"
        },
        {
          "exists": "body > main h1",
          "label": "the page's content in <main>, with its heading"
        },
        {
          "text": "body > footer:last-child",
          "contains": "Docking Ring B",
          "label": "the footer (<footer>) at the very end of the page"
        },
        {
          "hidden": "header nav",
          "label": "the menu (the nav in the header)"
        },
        {
          "click": "#menu-button",
          "label": "the button #menu-button"
        },
        {
          "visible": "header nav",
          "label": "the menu (the nav in the header)"
        }
      ]
    },
    {
      "name": "The list is empty and the card waits in a template",
      "visible": true,
      "page": "tracker.html",
      "steps": [
        {
          "exists": "main ul#ships",
          "label": "a list (<ul>) with the id ships in the main part"
        },
        {
          "count": "#ships li",
          "equals": 0,
          "label": "items in the list #ships"
        },
        {
          "exists": "main template#ship-template",
          "label": "a <template> with the id ship-template in the main part"
        },
        {
          "count": ".ship-name, .ship-class, .ship-status",
          "equals": 0,
          "label": "parts of a card shown on the page"
        }
      ]
    },
    {
      "name": "A copy of the template is a whole card",
      "visible": true,
      "page": "tracker.html",
      "files": {
        "menu.js": "const mold = document.querySelector(\"#ship-template\");\nconst list = document.querySelector(\"#ships\");\nlist.append(mold.content.cloneNode(true));\nlist.append(mold.content.cloneNode(true));\n"
      },
      "steps": [
        {
          "count": "#ships > li.ship",
          "equals": 2,
          "label": "cards (li.ship) in the list, after putting two copies of the template there"
        },
        {
          "text": "#ships > li.ship .ship-name",
          "nonEmpty": true,
          "label": "the card's name (.ship-name)"
        },
        {
          "text": "#ships > li.ship .ship-class",
          "nonEmpty": true,
          "label": "the card's class (.ship-class)"
        },
        {
          "text": "#ships > li.ship .ship-status",
          "nonEmpty": true,
          "label": "the card's status (.ship-status)"
        },
        {
          "order": [
            "#ships > li.ship .ship-name",
            "#ships > li.ship .ship-class",
            "#ships > li.ship .ship-status"
          ],
          "label": "the name, then the class, then the status"
        }
      ]
    },
    {
