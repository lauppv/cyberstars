          "on": "light",
          "label": "every heading of the main part",
          "every": true
        },
        {
          "contrast": ".stat-value",
          "atLeast": 4.5,
          "on": "light",
          "label": "every card's number",
          "every": true
        },
        {
          "differs": ".stat",
          "from": "body",
          "props": ["background-color"],
          "fromLabel": "the page",
          "label": "every card"
