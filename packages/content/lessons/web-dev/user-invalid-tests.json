          "from": "#phone, #email",
          "props": [
            "border-top-color",
            "border-top-style",
            "border-top-width",
            "background-color",
            "color",
            "box-shadow",
            "outline-style",
            "outline-color"
          ],
          "label": "the bags box with 4 bags",
          "fromLabel": "the phone box with 555 0199 and the email box not touched yet"
        },
        {
          "click": "form button:not([type]), form [type=\"submit\" i]",
          "label": "the send button of the form"
        },
        {
          "notSent": true
        },
        {
          "differs": "#flight",
          "from": "#flight-back",
          "props": [
            "border-top-color",
            "border-top-style",
            "border-top-width",
            "background-color",
            "color",
            "box-shadow",
            "outline-style",
