        },
        {
          "playing": "#pad-camera",
          "label": "the pad camera (#pad-camera)"
        },
        {
          "wait": 3000
        },
        {
          "wait": 3000
        },
        {
          "playing": "#pad-camera",
          "label": "the pad camera (#pad-camera)"
