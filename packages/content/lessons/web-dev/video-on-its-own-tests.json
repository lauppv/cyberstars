          "open": "dashboard.html"
        },
        {
          "exists": "main video#pad-camera",
          "label": "the pad camera (#pad-camera) in the main part"
        },
        {
          "loaded": "#pad-camera",
          "label": "the pad camera (#pad-camera)"
        },
        {
          "playing": "#pad-camera",
          "label": "the pad camera (#pad-camera)"
        },
        {
          "muted": "#pad-camera",
          "label": "the pad camera (#pad-camera)"
        }
      ]
    },
    {
      "name": "The pad camera can still be paused",
      "visible": true,
      "steps": [
        {
          "open": "dashboard.html"
        },
        {
