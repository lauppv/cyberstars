{
  "cases": [
    {
      "name": "style.css is linked from the head",
      "visible": true,
      "steps": [
        {
          "exists": "head link[rel=\"stylesheet\"][href=\"style.css\"]",
          "label": "a <link> to style.css in the <head>"
        }
      ]
    },
    {
      "name": "The biggest heading has a color of its own",
      "visible": true,
      "steps": [
        {
          "style": "h1",
          "prop": "color",
          "not": "rgb(0, 0, 0)",
          "label": "the biggest heading"
        }
      ]
    },
    {
      "name": "The rules come from style.css",
      "visible": false,
      "files": {
        "style.css": "h1 { color: rgb(1, 2, 3); }"
      },
      "steps": [
        {
          "style": "h1",
          "prop": "color",
          "equals": "rgb(1, 2, 3)",
          "label": "the biggest heading"
        }
      ]
    }
  ]
}
