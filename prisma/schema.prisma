generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CurriculumKind {
  editor
  terminal
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum TicketType {
  BUG
  QUESTION
  RULE_VIOLATION
  FEEDBACK
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  role            Role      @default(USER)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(512)
  bio             String?   @db.VarChar(200)
  status          String?   @db.VarChar(80)
  statusExpiresAt    DateTime? @map("status_expires_at")
  resetCode          String?   @map("reset_code") @db.VarChar(6)
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  pendingEmail             String?   @map("pending_email") @db.VarChar(255)
  emailChangeCode          String?   @map("email_change_code") @db.VarChar(6)
  emailChangeCodeExpiresAt DateTime? @map("email_change_code_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  progress  UserLessonProgress[]
  savedCode UserSavedCode[]
  threads   ForumThread[]
  posts     ForumPost[]
  reactions ForumReaction[]
  tickets         SupportTicket[]
  supportMessages SupportMessage[]

  @@map("users")
}

model SupportTicket {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  type      TicketType
  subject   String       @db.VarChar(200)
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int      @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

model Curriculum {
  id          Int      @id @default(autoincrement())
  key         String         @unique @db.VarChar(50)
  title       String         @db.VarChar(100)
  description String
  kind        CurriculumKind @default(editor)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("curriculum")
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseKey   String   @map("course_key") @db.VarChar(50)
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  hasCodeFile Boolean  @default(false) @map("has_code_file")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courseKey, slug])
  @@map("lessons")
}

model UserLessonProgress {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  courseKey       String    @map("course_key") @db.VarChar(50)
  lessonSlug      String    @map("lesson_slug") @db.VarChar(100)
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@index([userId, courseKey])
  @@map("user_lesson_progress")
}

model UserSavedCode {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  courseKey  String   @map("course_key") @db.VarChar(50)
  lessonSlug String   @map("lesson_slug") @db.VarChar(100)
  code       String
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@map("user_saved_code")
}

model ForumCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String
  icon        String   @db.VarChar(10)
  color       String   @db.VarChar(20)
  groupName   String   @map("group_name") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  authorId   Int      @map("author_id")
  title      String   @db.VarChar(255)
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  solved     Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts    ForumPost[]

  @@index([categoryId])
  @@index([authorId])
  @@index([updatedAt])
  @@map("forum_threads")
}

model ForumPost {
  id            Int      @id @default(autoincrement())
  threadId      Int      @map("thread_id")
  authorId      Int      @map("author_id")
  content       String
  solution      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  editedByName  String?  @map("edited_by_name") @db.VarChar(100)
  deleted       Boolean  @default(false)
  deletedByName String?  @map("deleted_by_name") @db.VarChar(100)

  thread    ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions ForumReaction[]

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumReaction {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  userId Int    @map("user_id")
  emoji  String @db.VarChar(10)

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("forum_reactions")
}
