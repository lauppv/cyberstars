generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  progress  UserLessonProgress[]
  savedCode UserSavedCode[]
  threads   ForumThread[]
  posts     ForumPost[]
  reactions ForumReaction[]

  @@map("users")
}

model Curriculum {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(50)
  title       String   @db.VarChar(100)
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("curriculum")
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseKey   String   @map("course_key") @db.VarChar(50)
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  hasCodeFile Boolean  @default(false) @map("has_code_file")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courseKey, slug])
  @@map("lessons")
}

model UserLessonProgress {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  courseKey       String    @map("course_key") @db.VarChar(50)
  lessonSlug      String    @map("lesson_slug") @db.VarChar(100)
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@index([userId, courseKey])
  @@map("user_lesson_progress")
}

model UserSavedCode {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  courseKey  String   @map("course_key") @db.VarChar(50)
  lessonSlug String   @map("lesson_slug") @db.VarChar(100)
  code       String
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@map("user_saved_code")
}

model ForumCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String
  icon        String   @db.VarChar(10)
  color       String   @db.VarChar(20)
  groupName   String   @map("group_name") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  authorId   Int      @map("author_id")
  title      String   @db.VarChar(255)
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  solved     Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts    ForumPost[]

  @@index([categoryId])
  @@index([authorId])
  @@index([updatedAt])
  @@map("forum_threads")
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  threadId  Int      @map("thread_id")
  authorId  Int      @map("author_id")
  content   String
  solution  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  thread    ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions ForumReaction[]

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumReaction {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  userId Int    @map("user_id")
  emoji  String @db.VarChar(10)

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("forum_reactions")
}
