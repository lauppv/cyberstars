generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CurriculumKind {
  editor
  terminal
}

enum Role {
  USER
  MODERATOR
  ADMIN
  FOUNDER
}

enum TicketType {
  BUG
  QUESTION
  RULE_VIOLATION
  FEEDBACK
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationType {
  FORUM_REPLY
  FORUM_SOLUTION
  FORUM_REACTION
  SUPPORT_TICKET_NEW
  SUPPORT_REPLY
  SUPPORT_STATUS
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
}

// A connection between two users, modelled as a directed request that becomes
// mutual once accepted. `requester` sent it, `addressee` received it; while
// PENDING only the addressee can accept/decline, and once ACCEPTED the pair is
// connected regardless of who initiated. The @@unique blocks a duplicate
// request in the same direction — the reverse direction is checked in the
// service so A->B and B->A can't coexist.
enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model Connection {
  id          Int              @id @default(autoincrement())
  requesterId Int              @map("requester_id")
  addresseeId Int              @map("addressee_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("ConnectionsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("connections")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  password        String    @db.VarChar(255)
  role            Role      @default(USER)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(512)
  bio             String?   @db.VarChar(200)
  status          String?   @db.VarChar(80)
  statusExpiresAt    DateTime? @map("status_expires_at")
  resetCode          String?   @map("reset_code") @db.VarChar(6)
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  pendingEmail             String?   @map("pending_email") @db.VarChar(255)
  emailChangeCode          String?   @map("email_change_code") @db.VarChar(6)
  emailChangeCodeExpiresAt DateTime? @map("email_change_code_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  // Public-profile privacy toggles (default: everything visible). Own view
  // ignores these; other viewers see a field only when its flag is true.
  showBio      Boolean @default(true) @map("show_bio")
  showStats    Boolean @default(true) @map("show_stats")
  showProgress Boolean @default(true) @map("show_progress")
  showActivity Boolean @default(true) @map("show_activity")
  // Whether other viewers see this user's connections list on their public
  // profile (own view ignores it). The connections themselves stay functional
  // when off — only the public listing is hidden.
  showConnections Boolean @default(true) @map("show_connections")

  progress  UserLessonProgress[]
  savedCode UserSavedCode[]
  threads   ForumThread[]
  posts     ForumPost[]
  reactions ForumReaction[]
  tickets         SupportTicket[]
  supportMessages SupportMessage[]
  dailyPicks      DailyPick[]

  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")

  conversationsA Conversation[]  @relation("ConvA")
  conversationsB Conversation[]  @relation("ConvB")
  sentMessages   DirectMessage[]
  dmReactions    DmReaction[]

  connectionsRequested Connection[] @relation("ConnectionsRequested")
  connectionsReceived  Connection[] @relation("ConnectionsReceived")

  @@map("users")
}

// A 1-to-1 direct-message thread. The two participants are stored as a canonical
// ordered pair (userAId < userBId) so A<->B and B<->A can't create duplicate
// rows — the @@unique enforces exactly one conversation per pair.
model Conversation {
  id        Int      @id @default(autoincrement())
  userAId   Int      @map("user_a_id")
  userBId   Int      @map("user_b_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userA    User            @relation("ConvA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User            @relation("ConvB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("conversations")
}

model DirectMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  content        String
  readAt         DateTime? @map("read_at")
  editedAt       DateTime? @map("edited_at")
  deleted        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions    DmReaction[]

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model DmReaction {
  id        Int    @id @default(autoincrement())
  messageId Int    @map("message_id")
  userId    Int    @map("user_id")
  emoji     String @db.VarChar(10)

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("dm_reactions")
}

// One lesson and one algorithm challenge picked per day (kind = "lesson" |
// "algo"), shared by every user — the same choice is stored in each user's row
// so the per-user bonus (bonusAwarded) can be tracked. Completing the pick on
// its day grants a bonus that the derived XP calc credits — see daily.service
// and progress.service.
model DailyPick {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  date         String   @db.VarChar(10)
  kind         String   @db.VarChar(10)
  courseKey    String   @map("course_key") @db.VarChar(50)
  lessonSlug   String   @map("lesson_slug") @db.VarChar(100)
  title        String   @db.VarChar(255)
  bonusAwarded Boolean  @default(false) @map("bonus_awarded")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, kind])
  @@index([userId, courseKey])
  @@map("daily_picks")
}

model SupportTicket {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  type      TicketType
  subject   String       @db.VarChar(200)
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int      @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  actorId   Int?             @map("actor_id")
  type      NotificationType
  entityId  Int              @map("entity_id")
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Curriculum {
  id          Int      @id @default(autoincrement())
  key         String         @unique @db.VarChar(50)
  title       String         @db.VarChar(100)
  description String
  kind        CurriculumKind @default(editor)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("curriculum")
}

model Lesson {
  id          Int      @id @default(autoincrement())
  courseKey   String   @map("course_key") @db.VarChar(50)
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  hasCodeFile Boolean  @default(false) @map("has_code_file")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([courseKey, slug])
  @@map("lessons")
}

model UserLessonProgress {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  courseKey       String    @map("course_key") @db.VarChar(50)
  lessonSlug      String    @map("lesson_slug") @db.VarChar(100)
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@index([userId, courseKey])
  @@map("user_lesson_progress")
}

model UserSavedCode {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  courseKey  String   @map("course_key") @db.VarChar(50)
  lessonSlug String   @map("lesson_slug") @db.VarChar(100)
  code       String
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey, lessonSlug])
  @@index([userId])
  @@map("user_saved_code")
}

model ForumCategory {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String
  icon        String   @db.VarChar(10)
  color       String   @db.VarChar(20)
  groupName   String   @map("group_name") @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  authorId   Int      @map("author_id")
  title      String   @db.VarChar(255)
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  solved     Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  category  ForumCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts     ForumPost[]
  viewLogs  ForumThreadView[]

  @@index([categoryId])
  @@index([authorId])
  @@index([updatedAt])
  @@map("forum_threads")
}

model ForumThreadView {
  id        Int      @id @default(autoincrement())
  threadId  Int      @map("thread_id")
  viewerKey String   @map("viewer_key") @db.VarChar(80)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, viewerKey])
  @@index([threadId])
  @@map("forum_thread_views")
}

model ForumPost {
  id            Int      @id @default(autoincrement())
  threadId      Int      @map("thread_id")
  authorId      Int      @map("author_id")
  content       String
  solution      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  editedByName  String?  @map("edited_by_name") @db.VarChar(100)
  deleted       Boolean  @default(false)
  deletedByName String?  @map("deleted_by_name") @db.VarChar(100)

  thread    ForumThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions ForumReaction[]

  @@index([threadId])
  @@index([authorId])
  @@map("forum_posts")
}

model ForumReaction {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  userId Int    @map("user_id")
  emoji  String @db.VarChar(10)

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("forum_reactions")
}
