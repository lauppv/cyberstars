{
  "checks": [
    { "kind": "dir_exists", "path": "roster" },
    { "kind": "files_equal", "a": "team-a.txt", "b": "roster/team-a.txt" },
    { "kind": "files_equal", "a": "team-b.txt", "b": "roster/team-b.txt" }
  ],
  "requires": [
    {
      "kind": "command",
      "pattern": "cat\\b.*team-a\\.txt.*team-b\\.txt|cat\\b.*team-b\\.txt.*team-a\\.txt"
    },
    { "kind": "command", "pattern": "cat\\b.*-n\\b.*team-a\\.txt" },
    { "kind": "command", "name": "cp" }
  ]
}
