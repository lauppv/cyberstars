[
  {
    "name": "Log files were moved to logs/",
    "check": "file_exists",
    "path": "logs/reactor.log"
  },
  {
    "name": "All log files are in logs/",
    "check": "file_exists",
    "path": "logs/navigation.log"
  },
  {
    "name": "Config files were moved to config/",
    "check": "file_exists",
    "path": "config/security.conf"
  },
  {
    "name": "critical-issues.txt contains CRITICAL lines",
    "check": "file_content",
    "path": "reports/critical-issues.txt",
    "mode": "contains",
    "expected": "CRITICAL"
  },
  {
    "name": "sorted-config.txt exists and is sorted",
    "check": "file_content",
    "path": "reports/sorted-config.txt",
    "mode": "contains",
    "expected": "access_level=restricted"
  },
  {
    "name": "security.conf has restricted permissions (600)",
    "check": "command_output",
    "probe": "stat -c %a config/security.conf",
    "mode": "contains",
    "expected": "600"
  },
  {
    "name": "mission-summary.txt contains STATUS: COMPLETE",
    "check": "file_content",
    "path": "reports/mission-summary.txt",
    "mode": "contains",
    "expected": "STATUS: COMPLETE"
  }
]
