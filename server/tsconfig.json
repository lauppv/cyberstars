{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "./**/*.ts",
    "../packages/shared/**/*.ts",
    "../packages/content/**/*.ts",
    "../scripts/**/*.ts",
    "../test/integration/**/*.ts",
    "../prisma/**/*.ts",
    "../prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
